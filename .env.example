# Keep credentials in .dev.vars (server only). Never use a VITE_ prefix for a key.
JEV_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional overrides; defaults are resolved in server/config.ts.
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# CHANGELOG_MODEL=claude-haiku-4-5-20251001

# Coolify: set BASE_PATH at build time; the others are runtime-only.
# BASE_PATH=/iamnbutler/jev-demos/
# PUBLIC_ORIGIN=https://demos.githubnext.com
# HOST=0.0.0.0
# PORT=3213
